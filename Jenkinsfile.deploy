pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_VERSION',
            defaultValue: 'latest',
            description: 'Versión de imagen'
        )

        string(
            name: 'DEPLOY_ENV',
            defaultValue: 'staging',
            description: 'Entorno'
        )
    }

    environment {
        IMAGE_NAME = 'rcinpan963/app-ci-cintaspaniagua'
        CONTAINER_NAME = 'app-ci-cintaspaniagua'
        SERVER_USER = 'ubuntu'
        SERVER_IP = '51.77.147.161'
    }

    stages {

        stage('Deploy SSH') {

            steps {

                sshagent(credentials: ['ssh-server-key']) {

                    sh """
                        ssh -o StrictHostKeyChecking=no ${SERVER_USER}@${SERVER_IP} '
                            docker pull ${IMAGE_NAME}:${params.IMAGE_VERSION}-php82 &&
                            docker rm -f ${CONTAINER_NAME} || true &&
                            docker run -d \
                                --name ${CONTAINER_NAME} \
                                -p 8082:80 \
                                ${IMAGE_NAME}:${params.IMAGE_VERSION}-php82 &&
                            curl -f http://localhost
                        '
                    """
                }
            }
        }
    }
}