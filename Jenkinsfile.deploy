pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_VERSION',
            defaultValue: 'latest',
            description: 'Versión de imagen'
        )

        string(
            name: 'DEPLOY_ENV',
            defaultValue: 'staging',
            description: 'Entorno'
        )
    }

    environment {
        IMAGE_NAME = 'rcinpan963/app-ci-cintaspaniagua'
        CONTAINER_NAME = 'app-ci-cintaspaniagua'
        SERVER_USER = 'ubuntu'
        SERVER_IP = '51.77.147.161'
    }

    stages {

        stage('Deploy SSH') {

            steps {

                sshagent(credentials: ['ssh-server-key']) {

                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@51.77.147.161 '
                        docker pull rcinpan963/app-ci-cintaspaniagua:latest-php82 &&
                        docker rm -f app-ci-cintaspaniagua 2>/dev/null || true &&
                        docker run -d --name app-ci-cintaspaniagua -p 8082:80 rcinpan963/app-ci-cintaspaniagua:latest-php82 &&
                        curl -f http://localhost:8082
                        '
                    """
                }
            }
        }
    }
}